      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (source) (count_over_time({service_name=~\"claude-code|claude-code-desktop\"} | event_name=\"tool_decision\" | decision=\"reject\" [$__auto]))",
