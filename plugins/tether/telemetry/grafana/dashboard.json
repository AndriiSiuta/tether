          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Auto gate denied",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (from_mode) (count_over_time({service_name=~\"claude-code|claude-code-desktop\"} | event_name=\"permission_mode_changed\" | trigger=\"auto_gate_denied\" [$__auto]))",
          "legendFormat": "{{from_mode}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "MCP connection errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (server_name, transport_type) (count_over_time({service_name=~\"claude-code|claude-code-desktop\"} | event_name=\"mcp_server_connection\" | status=\"failed\" [$__auto]))",
          "legendFormat": "{{server_name}} {{transport_type}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Session traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"claude-code|claude-code-desktop\" && name = \"claude_code.interaction\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "repository",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"claude_code_cost_usage(_USD)?_total\"}, repository)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values({__name__=~\"claude_code_cost_usage(_USD)?_total\"}, repository)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  }
}
